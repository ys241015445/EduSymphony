# ============================================
# EduSymphony 环境变量配置
# 复制为 .env 并填入你的 API Key
# ============================================

# --- AI 模型 API Key（至少配置一个） ---

QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

KIMI_API_KEY=your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0905-preview

DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-251015

# ⚠️ DEPRECATED：以下变量已不再被 _do_ppt 读取
# PPT 生成已统一切换为「本地两阶段豆包深度生成 + python-pptx 渲染」
# （第一阶段生成 15-25 页结构化大纲，第二阶段 8 并发深度生成每一页内容）
# 留着这两行只是为了兼容老 .env，删不删都行。
DOUBAO_PPT_BOT_ID=
DOUBAO_PPT_BOT_TIMEOUT=180

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

SPARK_API_KEY=your-spark-api-key
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1
SPARK_MODEL=generalv3.5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 安全 ---

JWT_SECRET=change-this-to-a-random-string-in-production

# --- 数据库（Docker 容器内路径，本地开发不需要设置） ---

DATABASE_URL=sqlite+aiosqlite:///./database/edusymphony.db
