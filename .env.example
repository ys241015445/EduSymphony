# -----------------------------------------------------------------------------
# Repo root `.env` — loaded by docker-compose (`env_file: .env`).
# Local `uvicorn` from `backend/`: copy the same keys to `backend/.env`.
# Never commit real secrets; do not paste production passwords into README or issues.
# -----------------------------------------------------------------------------

# --- Application (optional overrides; defaults in backend/app/core/config.py) ---
# APP_ENV=development
# APP_DEBUG=true
# LOG_LEVEL=INFO
# PDF_CJK_FONT_PATH=

QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-plus

KIMI_API_KEY=your-kimi-api-key
KIMI_MODEL=kimi-k2-0905-preview

DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seed-1-6-251015

# ---------------------------------------------------------------
# DEPRECATED: no longer read by application code; kept for old .env compatibility
# ---------------------------------------------------------------
# Legacy PPT paths (Volcengine Ark bot, Coze Bot) were removed; PPT uses local
# two-stage Doubao + python-pptx. You may delete these keys from your .env.
DOUBAO_PPT_BOT_ID=
DOUBAO_PPT_BOT_TIMEOUT=180
COZE_API_KEY=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_PPT_TIMEOUT=300
COZE_POLL_INTERVAL=2.0
# ---------------------------------------------------------------

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

SPARK_API_KEY=your-spark-api-key
SPARK_MODEL=generalv3.5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional provider base URLs (omit to use built-in defaults in config.py)
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1

JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# --- Database (Supabase PostgreSQL) ---
# 推荐（生产）：Transaction Pooler 端口 6543
#   - 用户名格式 postgres.[PROJECT_REF]
#   - 代码在 pooler 下自动关闭 prepared statement 缓存
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# 备选 A：Session Pooler 5432
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# 备选 B：直连（仅开发/低并发）
# DATABASE_URL=postgresql+asyncpg://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Supabase REST (optional) ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co/rest/v1/
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# System banner (empty = disabled)
BANNER_TEXT=

# ────────────────────────────────────────
# 并发队列（Postgres-backed，支持重启恢复、多实例共享）
# ────────────────────────────────────────
MAX_CONCURRENT_TASKS=8
MAX_PER_USER_TASKS=3
TASK_TIMEOUT_SEC=1200
WORKER_LEASE_SEC=1800
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_SWEEP_INTERVAL_SEC=30
QUEUE_GC_DAYS=7

# ────────────────────────────────────────
# 数据库连接池（可选覆盖，留空用代码内自适应默认）
# ────────────────────────────────────────
# Pooler 模式默认 15，直连模式默认 10
# DB_POOL_SIZE=15
# Pooler 模式默认 20，直连模式默认 10
# DB_MAX_OVERFLOW=20
# 检出一条连接的最长等待秒数
# DB_POOL_TIMEOUT=30
# 连接回收秒数（Transaction pooler 下代码默认 90s，直连默认 1800s）
# DB_POOL_RECYCLE=1800
# 服务端单条 SQL 超时（毫秒）
# DB_STATEMENT_TIMEOUT_MS=120000
# 事务空闲超时（毫秒）
# DB_IDLE_TX_TIMEOUT_MS=300000
# asyncpg 客户端单命令超时（秒）
# DB_COMMAND_TIMEOUT_SEC=180
