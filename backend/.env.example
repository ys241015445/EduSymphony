QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen-plus

KIMI_API_KEY=your-kimi-api-key
KIMI_MODEL=kimi-k2-0905-preview

DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seed-1-6-251015

# ---------------------------------------------------------------
# ⚠️ 以下变量已 DEPRECATED（不再被代码读取，留着只是为了兼容老 .env）
# ---------------------------------------------------------------
# 历史上 PPT 生成走过两个外部链路，都已下线：
#   1) 火山方舟 PPT 智能体（DOUBAO_PPT_BOT_ID）
#   2) Coze（扣子）Bot + aippt 第三方插件
# 实测 Coze Bot 返回的是营销页面 URL，不是真 .pptx 二进制；方舟 Bot 也无法稳定产出
# 课堂可用的可视化 PPT。现已统一切换为「本地两阶段豆包深度生成 + python-pptx 渲染」。
# 如果你之前在 .env 里填过下面这些，删不删都行——_do_ppt 已经不会读它们。
DOUBAO_PPT_BOT_ID=
DOUBAO_PPT_BOT_TIMEOUT=180
COZE_API_KEY=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_PPT_TIMEOUT=300
COZE_POLL_INTERVAL=2.0
# ---------------------------------------------------------------

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

SPARK_API_KEY=your-spark-api-key
SPARK_MODEL=generalv3.5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

JWT_SECRET=change-me-in-production

# --- Database (Supabase PostgreSQL) ---
# ✅ 推荐（生产默认）：Transaction Pooler (端口 6543)
#   - 高并发 + 长 AI 任务的最佳方案
#   - 用户名格式为 postgres.[PROJECT_REF]
#   - 服务端连接在每次 commit 后即时归还
#   - 代码已自动关闭 prepared statements 缓存
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# 备选 A：Session Pooler (端口 5432) —— 需要保留 prepared statements 时使用
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# 备选 B：直连 (仅开发/单实例小规模，并发连接受限于 Supabase 项目上限)
# DATABASE_URL=postgresql+asyncpg://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co/rest/v1/
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# System banner (leave empty to disable)
BANNER_TEXT=

# ────────────────────────────────────────
# 并发队列（Postgres-backed，支持重启恢复、多实例共享）
# ────────────────────────────────────────
# 进程内 worker 协程数 = 全局最大并发 AI 任务数（也决定数据库连接池默认 sizing）
MAX_CONCURRENT_TASKS=8
# 单用户最大并发任务数（防止单用户刷屏）
MAX_PER_USER_TASKS=3
# 单任务最长执行秒数（超过强制终止并释放名额）
TASK_TIMEOUT_SEC=1200
# worker 租约秒数（worker crash 超过该时间后 sweeper 回队重跑）
WORKER_LEASE_SEC=1800
# 队列轮询间隔（毫秒），空闲时自适应退避至 3s
QUEUE_POLL_INTERVAL_MS=1000
# sweeper 扫描周期（秒）——回收超时 lease + GC
QUEUE_SWEEP_INTERVAL_SEC=30
# 完成/失败 job 保留天数（超过被 sweeper 删除）
QUEUE_GC_DAYS=7

# ────────────────────────────────────────
# 数据库连接池（可选覆盖，留空用代码内自适应默认）
# ────────────────────────────────────────
# Pooler 模式默认 15，直连模式默认 10
# DB_POOL_SIZE=15
# Pooler 模式默认 20，直连模式默认 10
# DB_MAX_OVERFLOW=20
# 检出一条连接的最长等待秒数
# DB_POOL_TIMEOUT=30
# 连接回收秒数（避免 Supabase 超时断链）
# DB_POOL_RECYCLE=1800
# 服务端单条 SQL 超时（毫秒）
# DB_STATEMENT_TIMEOUT_MS=120000
# 事务空闲超时（毫秒）
# DB_IDLE_TX_TIMEOUT_MS=300000
# asyncpg 客户端单命令超时（秒）
# DB_COMMAND_TIMEOUT_SEC=180
