# -----------------------------------------------------------------------------
# Local backend/.env (cwd when running uvicorn from backend/).
# Repo root .env is for docker-compose; keep the same keys—see ../.env.example.
# Never commit real secrets.
# -----------------------------------------------------------------------------

# --- Application (optional overrides; defaults in app/core/config.py) ---
# APP_ENV=development
# APP_DEBUG=true
# LOG_LEVEL=INFO
# PDF_CJK_FONT_PATH=
# 珠科教案 docx→pdf 转换（LibreOffice headless）。默认自动探测；非标准安装路径时可指定：
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

QWEN_API_KEY=your-qwen-api-key
QWEN_MODEL=qwen3.8-max
# 视觉/多模态模型（立体几何「上传题目图片解题」入口用），走同一 DashScope 兼容通道
QWEN_VL_MODEL=qwen3.7-plus

KIMI_API_KEY=your-kimi-api-key
KIMI_MODEL=kimi-k2.6
# 珠科教案助手 (semester_helper.zhuke) 专用配置
KIMI_K2_MODEL=kimi-k2.6
KIMI_K2_CONCURRENCY=4
KIMI_K2_TIMEOUT_SEC=120
# KIMI_K2_TEMPERATURE=   # 可选，覆盖 Kimi 采样温度
ZHUKE_LAYOUT_REVIEW_ON_LINT=0
# 强制每节都走 Kimi 排版质检（默认关；开启后 API 调用量翻倍）
# ZHUKE_LAYOUT_REVIEW_ALWAYS=0
# ZHUKE_LESSON_LEASE_SEC=600   # 珠科单课租约下限，实际取 max(此值, TASK_TIMEOUT_SEC)

DOUBAO_API_KEY=your-doubao-api-key
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
# 文生图模型（英语卡片/知识漫画配图）。留空=关闭配图；填 Seedream 模型 id 开启（已验证可用：doubao-seedream-4-0-250828）
DOUBAO_IMAGE_MODEL=

# ── 导出/下载付费闸门（扫码 + 邮件 + 管理员额度） ──────────
# 流程：静态收款码 →「我已支付」发临时额度并邮件通知管理员 → 管理员 confirm / 改 export_credits
# 无 V免签 / 无第三方自动确认
EXPORT_PRICE=5
EXPORT_CREDITS_PER_ORDER=1
EXPORT_ORDER_TIMEOUT_SEC=300
EXPORT_TEMP_CREDITS=1
ADMIN_PAYMENT_EMAIL=778636011@qq.com
ALIPAY_QR=
WECHAT_QR=
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------
# ⚠️ 以下变量已 DEPRECATED（不再被代码读取，留着只是为了兼容老 .env）
# ---------------------------------------------------------------
DOUBAO_PPT_BOT_ID=
DOUBAO_PPT_BOT_TIMEOUT=180
COZE_API_KEY=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_PPT_TIMEOUT=300
COZE_POLL_INTERVAL=2.0
# ---------------------------------------------------------------

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-pro
# 珠科材料助手（工作台 /zhuke-materials）：正文走 DeepSeek；缺密钥则该模块 API 返回 503
ZHUKE_MATERIALS_DEEPSEEK_MODEL=deepseek-v4-pro

SPARK_API_KEY=your-spark-api-key
SPARK_MODEL=4.0Ultra

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional provider base URLs (omit to use built-in defaults in config.py)
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1

JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Supabase ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co/rest/v1/
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

BANNER_TEXT=

# ────────────────────────────────────────
# 并发队列（Postgres-backed，支持重启恢复、多实例共享）
# ────────────────────────────────────────
MAX_CONCURRENT_TASKS=6
MAX_PER_USER_TASKS=4
TASK_TIMEOUT_SEC=1200
LESSON_TASK_TIMEOUT_SEC=3600
TOOL_TASK_TIMEOUT_SEC=600
WORKER_LEASE_SEC=1800
QUEUE_POLL_INTERVAL_MS=800
QUEUE_SWEEP_INTERVAL_SEC=30
# Coolify 生产 compose 默认 3；本地 compose 默认 7
QUEUE_GC_DAYS=7

# ────────────────────────────────────────
# 数据库连接池（可选覆盖，留空用代码内自适应默认）
# ────────────────────────────────────────
DB_POOL_SIZE=16
DB_MAX_OVERFLOW=6
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_STATEMENT_TIMEOUT_MS=120000
# DB_IDLE_TX_TIMEOUT_MS=300000
# DB_COMMAND_TIMEOUT_SEC=180
