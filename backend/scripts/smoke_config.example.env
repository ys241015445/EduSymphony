# EduSymphony 冒烟测试配置示例

# 复制为 backend/.env 同级或 export 后运行 smoke_all_features.py



# 后端 API 根地址（本地 uvicorn 默认 3002；Docker 全栈经 Nginx 反代时为 http://localhost:3002 或容器内 backend:8000）

SMOKE_BASE_URL=http://localhost:3002



# 前端地址（Playwright --ui 时使用；Vite dev 默认 3000；Docker compose 前端映射 3002 时需改为 http://localhost:3002）

SMOKE_FRONTEND_URL=http://localhost:3000



# 测试账号（需已存在于 Supabase users 表）

SMOKE_USER=lzf

SMOKE_PASS=your-password-here



# 可选：指定已有教案 UUID，用于 export/material/lesson process UI 测试

# 留空则自动取列表第一条

SMOKE_LESSON_ID=

