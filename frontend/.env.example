# -----------------------------------------------------------------------------
# Optional Vite env (local `npm run dev` only).
# Production Docker builds do not need this: same-origin Nginx proxies /socket.io.
# Copy to `.env` or `.env.local` if you split frontend/backend origins in dev.
# -----------------------------------------------------------------------------

# Override Socket.IO origin (e.g. https://api.example.com). Leave unset for same-host.
# VITE_SOCKET_ORIGIN=

# Backend port on localhost when dev frontend proxies to a non-default port (default 3002).
# VITE_DEV_BACKEND_PORT=3002
